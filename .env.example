# Copy to .env.local and fill in. See SETUP.md for where each value comes from.
# Never commit .env.local.

BETTER_AUTH_URL=http://localhost:3000
# pnpm secrets  → prints the next two
BETTER_AUTH_SECRET=
APP_ENCRYPTION_KEY=

# The only Google account allowed to sign in and connect
ALLOWED_EMAIL=

# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Strava → Settings → My API Application (callback domain: localhost). Optional.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Claude API: set the key in Settings (stored encrypted) or here.
# ANTHROPIC_API_KEY=
# AI_PLAN_MODEL=claude-opus-5-5
# AI_FAST_MODEL=claude-haiku-5-5

DATABASE_URL=file:./data/app.db
APP_TIMEZONE=Europe/Warsaw
